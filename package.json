{
  "name": "@or3/secrets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local encrypted secret custody for OR3",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24",
    "bun": "1.3.14"
  },
  "bin": {
    "or3-secrets": "bin/or3-secrets.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./nuxt": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "docs",
    "planning/secure-secret-store"
  ],
  "scripts": {
    "test": "bun test --timeout 30000 tests",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts && tsc --emitDeclarationOnly",
    "qualify": "bun scripts/qualify.ts"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "4.5.2",
    "@nuxt/schema": "4.5.2",
    "@types/node": "24.13.5",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
